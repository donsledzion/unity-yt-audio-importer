.root-container {
    padding: 12px;
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

.header-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar_button-border);
}

.header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.status-badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffffff;
}

.status-badge--ready {
    background-color: #2e7d32;
}

.status-badge--warning {
    background-color: #f57c00;
}

.status-badge--error {
    background-color: #c62828;
}

.section-box {
    background-color: var(--unity-colors-box-background);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: var(--unity-colors-default-text);
}

.input-row {
    flex-direction: row;
    align-items: center;
}

.input-row > .unity-text-field {
    flex-grow: 1;
    margin-right: 6px;
}

.metadata-card {
    flex-direction: row;
    margin-top: 8px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
}

.metadata-thumbnail {
    width: 120px;
    height: 70px;
    border-radius: 4px;
    margin-right: 12px;
    background-color: #1a1a1a;
    -unity-background-scale-mode: scale-and-crop;
}

.metadata-info {
    flex-grow: 1;
    justify-content: center;
}

.metadata-title {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-overflow-position: end;
    margin-bottom: 4px;
}

.metadata-details {
    font-size: 11px;
    color: var(--unity-colors-default-text-subtle);
}

.waveform-controls {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
}

.trim-inputs-row {
    flex-direction: row;
    align-items: center;
}

.trim-inputs-row > .unity-float-field {
    width: 80px;
    margin-right: 8px;
}

.action-btn {
    height: 30px;
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 4px;
}

.action-btn--primary {
    background-color: #1976d2;
    color: #ffffff;
}

.action-btn--primary:hover {
    background-color: #1565c0;
}

.action-btn--success {
    background-color: #388e3c;
    color: #ffffff;
}

.action-btn--success:hover {
    background-color: #2e7d32;
}

.progress-container {
    margin-top: 6px;
    margin-bottom: 6px;
}

.footer-disclaimer {
    margin-top: auto;
    padding-top: 8px;
    font-size: 10px;
    color: var(--unity-colors-default-text-subtle);
    -unity-text-align: middle-center;
    white-space: normal;
}
